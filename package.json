{
  "name": "arpita-medical",
  "version": "1.0.0",
  "description": "Arpita Medical Pharmacy Retail Operations Desktop Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:angular": "cd frontend && npx ng build --configuration=production",
    "build:backend": "cd backend && ./mvnw clean package -DskipTests",
    "electron:build:win": "electron-builder --win --x64",
    "electron:build:mac": "electron-builder --mac --arm64",
    "create-installer": "npm run build:backend && npm run build:angular && npm run electron:build:win && npm run electron:build:mac",
    "desktop:build": "electron-builder --win"
  },
  "author": "Arpita Medical",
  "license": "ISC",
  "devDependencies": {
    "electron": "^30.0.9",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "build": {
    "appId": "com.arpitamedical.pharmacy",
    "productName": "Arpita Medical",
    "copyright": "Copyright © 2026 Arpita Medical",
    "compression": "normal",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "main.js",
      "preload.js",
      "frontend/dist/frontend/browser/**/*"
    ],
    "extraResources": [
      {
        "from": "backend/target/backend-0.0.1-SNAPSHOT.jar",
        "to": "backend.jar"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "publisherName": "Arpita Medical",
      "artifactName": "ArpitaMedical-${version}-win-x64.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "jre-win",
          "to": "jre",
          "filter": ["**/*"]
        }
      ]
    },
    "mac": {
      "category": "public.app-category.business",
      "artifactName": "ArpitaMedical-${version}-mac-arm64.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "jre-mac",
          "to": "jre",
          "filter": ["**/*"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Arpita Medical",
      "uninstallDisplayName": "Arpita Medical Pharmacy Suite",
      "deleteAppDataOnUninstall": false,
      "displayLanguageSelector": false,
      "packElevateHelper": true,
      "include": "build/installer.nsh",
      "differentialPackage": false
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://update.arpitamedical.com/releases/",
        "channel": "latest"
      }
    ]
  }
}
